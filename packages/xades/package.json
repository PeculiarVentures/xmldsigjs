{
  "name": "xadesjs",
  "version": "2.6.8",
  "description": "XML Advanced Electronic Signatures (XAdES) implementation in TypeScript/JavaScript built on XMLDSIGjs",
  "main": "./build/index.js",
  "module": "./build/index.mjs",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "module": "./build/index.mjs",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=16.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "build",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "echo \"Error: run tests from root\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeculiarVentures/xmldsigjs.git"
  },
  "keywords": [
    "xml",
    "xmldsig",
    "xades",
    "xadesjs",
    "webcrypto",
    "signature",
    "rsa",
    "ec"
  ],
  "author": "Peculiar Ventures LLC",
  "contributors": [
    "Miroshin Stepan <microshine@mail.ru>"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/PeculiarVentures/xmldsigjs/issues"
  },
  "homepage": "https://github.com/PeculiarVentures/xmldsigjs/blob/master/packages/xades/README.md",
  "dependencies": {
    "xml-core": "^1.2.6",
    "xmldsigjs": "^2.8.8"
  }
}
